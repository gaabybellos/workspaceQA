# Dependencies
node_modules/

# Target project source cloned by register-project
projects/*/source/

# Environment - never commit credentials
.env.local
.env.*.local

# Auto-generated by agents when the user chooses not to version outputs
docs/technical/*/*.generated.md

# Runner artifacts are created only after a runner is installed
automation/*/*/node_modules/
automation/*/*/test-results/
automation/*/*/reports/
automation/*/*/coverage/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.vscode/*.code-workspace
.idea/

# Runtime
*.log
npm-debug.log*

# Build output
dist/

# Artefatos do runner Playwright
automation/*/playwright/node_modules/
automation/*/playwright/allure-results/
automation/*/playwright/allure-report/
automation/*/playwright/test-results/
automation/*/playwright/.auth/
automation/*/playwright/.env
automation/*/playwright/dist/
